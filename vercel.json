{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/story",
      "permanent": true
    },
    {
      "source": "/clients",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/start",
      "destination": "/rewind",
      "permanent": false
    },
    {
      "source": "/services",
      "destination": "/engagement-model",
      "permanent": true
    },
    {
      "source": "/work-with-us",
      "destination": "/engagement-model",
      "permanent": true
    },
    {
      "source": "/hire-us",
      "destination": "/engagement-model",
      "permanent": true
    },
    {
      "source": "/enquire",
      "destination": "/engagement-model",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}